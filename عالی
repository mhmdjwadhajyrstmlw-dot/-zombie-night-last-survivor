def hit_button(p, rect):
    x, y, w, h = rect
    return x <= p[0] <= x + w and y <= p[1] <= y + h


def screen_to_base(pos):
    return pos[0] * W / SW, pos[1] * H / SH


def reload_gun():
    global reloading, reload_timer
    if not reloading and ammo < 24 and reserve_ammo > 0:
        reloading = True
        reload_timer = 1.35


def shoot():
    global ammo, fire_cooldown, muzzle_flash, score
    if game_over or reloading or fire_cooldown > 0 or ammo <= 0:
        return

    ammo -= 1
    fire_cooldown = 0.24 if aiming else 0.20
    muzzle_flash = 0.08

    best = None
    best_dist = 999
    max_angle = math.radians(5.2 if aiming else 3.8)

    for z in zombies[:]:
        dx, dy = z["x"] - player_x, z["y"] - player_y
        dist = math.hypot(dx, dy)
        rel = abs(wrap_angle(math.atan2(dy, dx) - angle))
        if rel < max_angle and dist < best_dist:
            if line_of_sight(player_x, player_y, z["x"], z["y"]):
                best, best_dist = z, dist

    if best:
        best["hp"] -= 70 if best_dist < 5 else 55
        best["hurt"] = 0.12
        if best["hp"] <= 0:
            score += 100
            zombies.remove(best)


def reset_game():
    global player_x, player_y, angle, pitch, health, score, wave, ammo
    global reserve_ammo, reloading, reload_timer, fire_cooldown
    global muzzle_flash, hurt_flash, jump_height, jump_velocity, game_over

    player_x, player_y, angle, pitch = 2.5, 2.5, 0.0, 0.0
    health, score, wave = 100, 0, 1
    ammo, reserve_ammo = 24, 144
    reloading, reload_timer = False, 0.0
    fire_cooldown, muzzle_flash, hurt_flash = 0.0, 0.0, 0.0
    jump_height, jump_velocity, game_over = 0.0, 0.0, False
    spawn_wave()


spawn_wave()

try:
    while True:
        dt = min(clock.tick(FPS) / 1000.0, 0.04)
        fire_cooldown = max(0, fire_cooldown - dt)
        muzzle_flash = max(0, muzzle_flash - dt)
        hurt_flash = max(0, hurt_flash - dt)

        if reloading:
            reload_timer -= dt
            if reload_timer <= 0:
                amount = min(24 - ammo, reserve_ammo)
                ammo += amount
                reserve_ammo -= amount
                reloading = False

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                raise SystemExit

            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    raise SystemExit
                elif event.key == pygame.K_r:
                    reload_gun()
                elif event.key == pygame.K_SPACE and jump_height <= 0.01:
                    jump_velocity = 3.3
                elif event.key == pygame.K_LSHIFT:
                    sprinting = True
                elif event.key == pygame.K_LCTRL:
                    aiming = True
                elif event.key == pygame.K_RETURN and game_over:
                    reset_game()

            elif event.type == pygame.KEYUP:
                if event.key == pygame.K_LSHIFT:
                    sprinting = False
                elif event.key == pygame.K_LCTRL:
                    aiming = False

            elif event.type == pygame.MOUSEBUTTONDOWN:
                p = screen_to_base(event.pos)
                if game_over:
                    reset_game()
                    continue
                if hit_button(p, FIRE):
                    fire_held = True
                    shoot()
                elif hit_button(p, AIM):
                    aiming = True
                elif hit_button(p, RUN):
                    sprinting = not sprinting
                elif hit_button(p, JUMP):
                    if jump_height <= 0.01:
                        jump_velocity = 3.3
                elif hit_button(p, RELOAD):
                    reload_gun()
                elif math.hypot(p[0] - MOVE[0], p[1] - MOVE[1]) < MOVE[2] * 0.6:
                    move_finger = "mouse"
                    move_x, move_y = 0.0, 0.0
                else:
                    mouse_look = True
                    mouse_last = p

            elif event.type == pygame.MOUSEBUTTONUP:
                fire_held = False
                aiming = False
                mouse_look = False
                mouse_last = None
                if move_finger == "mouse":
                    move_finger = None
                    move_x, move_y = 0.0, 0.0

            elif event.type == pygame.MOUSEMOTION:
                p = screen_to_base(event.pos)
                if mouse_look and mouse_last:
                    angle += (p[0] - mouse_last[0]) * 0.0045
                    pitch = clamp(pitch + (p[1] - mouse_last[1]) * 0.003, -0.55, 0.55)
                    mouse_last = p
                if move_finger == "mouse" and pygame.mouse.get_pressed()[0]:
                    dx, dy = p[0] - MOVE[0], p[1] - MOVE[1]
                    mag = max(1, math.hypot(dx, dy))
                    move_x = clamp(dx / mag, -1, 1) * min(1, mag / 45)
                    move_y = clamp(dy / mag, -1, 1) * min(1, mag / 45)

            elif event.type == pygame.FINGERDOWN:
                p = (event.x * W, event.y * H)
                if game_over:
                    reset_game()
                    continue
                mode = "look"
                if hit_button(p, FIRE):
                    mode = "fire"
                    fire_held = True
                    shoot()
                elif hit_button(p, AIM):
                    mode = "aim"
                    aiming = True
                elif hit_button(p, RUN):
                    mode = "run"
                    sprinting = not sprinting
                elif hit_button(p, JUMP):
                    mode = "jump"
                    if jump_height <= 0.01:
                        jump_velocity = 3.3
                elif hit_button(p, RELOAD):
                    mode = "reload"
                    reload_gun()
                elif math.hypot(p[0] - MOVE[0], p[1] - MOVE[1]) < MOVE[2] * 0.78:
                    mode = "move"
                    move_finger = event.finger_id
                touch_modes[event.finger_id] = [mode, p]

            elif event.type == pygame.FINGERMOTION:
                p = (event.x * W, event.y * H)
                item = touch_modes.get(event.finger_id)
                if item:
                    mode, last = item
                    if mode == "look":
                        angle += (p[0] - last[0]) * 0.006
                        pitch = clamp(pitch + (p[1] - last[1]) * 0.003, -0.55, 0.55)
                    elif mode == "move":
                        dx, dy = p[0] - MOVE[0], p[1] - MOVE[1]
                        mag = max(1, math.hypot(dx, dy))
                        move_x = clamp(dx / 42, -1, 1) * min(1, mag / 42)
                        move_y = clamp(dy / 42, -1, 1) * min(1, mag / 42)
                    touch_modes[event.finger_id] = [mode, p]

            elif event.type == pygame.FINGERUP:
                item = touch_modes.pop(event.finger_id, None)
                if item:
                    mode = item[0]
                    if mode == "fire":
                        fire_held = False
                    elif mode == "aim":
                        aiming = False
                    elif mode == "move":
                        move_finger = None
                        move_x, move_y = 0.0, 0.0

        if not game_over:
            keys = pygame.key.get_pressed()
            forward = int(keys[pygame.K_w] or keys[pygame.K_UP]) - int(
                keys[pygame.K_s] or keys[pygame.K_DOWN])
            strafe = int(keys[pygame.K_d] or keys[pygame.K_RIGHT]) - int(
                keys[pygame.K_a] or keys[pygame.K_LEFT])

            forward -= move_y
            strafe += move_x
            mag = math.hypot(forward, strafe)
            if mag > 1:
                forward, strafe = forward / mag, strafe / mag

            speed = 2.45 * (1.65 if sprinting or keys[pygame.K_LSHIFT] else 1)
            if aiming:
                speed *= 0.72

            dx = (math.cos(angle) * forward - math.sin(angle) * strafe) * speed * dt
            dy = (math.sin(angle) * forward + math.cos(angle) * strafe) * speed * dt
            player_x, player_y = move_collision(player_x, player_y, dx, dy)

            if jump_velocity or jump_height > 0:
                jump_height += jump_velocity * dt
                jump_velocity -= 8.5 * dt
                if jump_height <= 0:
                    jump_height, jump_velocity = 0.0, 0.0

            if fire_held and fire_cooldown <= 0:
                shoot()

            for z in zombies[:]:
                z["walk"] += dt
                z["hurt"] = max(0, z["hurt"] - dt)
                dist = math.hypot(player_x - z["x"], player_y - z["y"])

                if dist > 0.78 and line_of_sight(z["x"], z["y"], player_x, player_y):
                    vx = (player_x - z["x"]) / max(0.01, dist) * z["speed"] * dt
                    vy = (player_y - z["y"]) / max(0.01, dist) * z["speed"] * dt
                    z["x"], z["y"] = move_collision(z["x"], z["y"], vx, vy)
                elif dist <= 0.90:
                    z["attack"] -= dt
                    if z["attack"] <= 0:
                        health -= random.randint(5, 9)
                        hurt_flash = 0.45
                        z["attack"] = 0.9

            if health <= 0:
                health = 0
                game_over = True

            if not zombies:
                wave += 1
                reserve_ammo = min(300, reserve_ammo + 48)
                health = min(100, health + 12)
                spawn_wave()

        draw_world()
        for z in sorted(
            zombies,
            key=lambda item: math.hypot(item["x"] - player_x, item["y"] - player_y),
            reverse=True
        ):
            draw_zombie(z)

        draw_weapon()
        draw_ui()

        # Preserve the device's screen ratio by scaling to its full display.
        pygame.transform.scale(canvas, (SW, SH), screen)
        pygame.display.flip()

except SystemExit:
    pass
except Exception as error:
    print("SHADOW FPS error:", repr(error))
    raise
finally:
    pygame.quit()
    sys.exit()