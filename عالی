def clamp(v, lo, hi):
    return max(lo, min(hi, v))


def wrap_angle(a):
    return (a + math.pi) % (math.tau) - math.pi


def is_wall(x, y):
    ix, iy = int(x), int(y)
    if ix < 0 or iy < 0 or ix >= MAP_W or iy >= MAP_H:
        return True
    return WORLD[iy][ix] == "#"


def move_collision(x, y, dx, dy, radius=0.18):
    nx = x + dx
    if not is_wall(nx + (radius if dx >= 0 else -radius), y):
        x = nx
    ny = y + dy
    if not is_wall(x, ny + (radius if dy >= 0 else -radius)):
        y = ny
    return x, y


def free_spot(min_dist=3.5):
    spots = []
    for yy in range(1, MAP_H - 1):
        for xx in range(1, MAP_W - 1):
            if WORLD[yy][xx] == ".":
                sx, sy = xx + 0.5, yy + 0.5
                if math.hypot(sx - player_x, sy - player_y) >= min_dist:
                    spots.append((sx, sy))
    return random.choice(spots) if spots else (MAP_W - 2.5, MAP_H - 2.5)


def spawn_wave():
    zombies.clear()
    for _ in range(min(5 + wave * 2, 18)):
        x, y = free_spot()
        zombies.append({
            "x": x, "y": y,
            "hp": 100 + max(0, wave - 3) * 15,
            "speed": random.uniform(0.42, 0.63) + min(wave * 0.018, 0.2),
            "attack": 0.0,
            "walk": random.random() * 10,
            "hurt": 0.0,
            "size": random.uniform(0.9, 1.12),
            "tone": random.choice([0, 1, 2])
        })


def cast_ray(ray_angle):
    dx = math.cos(ray_angle)
    dy = math.sin(ray_angle)
    dist = 0.0
    while dist < MAX_DEPTH:
        dist += 0.035
        tx = player_x + dx * dist
        ty = player_y + dy * dist
        if is_wall(tx, ty):
            side = 0 if abs((tx % 1) - 0.5) > abs((ty % 1) - 0.5) else 1
            return dist, side, tx, ty
    return MAX_DEPTH, 0, player_x + dx * MAX_DEPTH, player_y + dy * MAX_DEPTH


def line_of_sight(x1, y1, x2, y2):
    dist = math.hypot(x2 - x1, y2 - y1)
    steps = max(2, int(dist / 0.12))
    for i in range(1, steps):
        t = i / steps
        if is_wall(x1 + (x2 - x1) * t, y1 + (y2 - y1) * t):
            return False
    return True


def draw_world():
    horizon = int(H / 2 + pitch * H * 0.8 + jump_height * 0.7)
    horizon = clamp(horizon, 90, H - 70)

    for y in range(H // 2):
        t = y / (H // 2)
        pygame.draw.line(
            canvas,
            (int(7 + 10 * t), int(13 + 12 * t), int(22 + 12 * t)),
            (0, y), (W, y)
        )

    for y in range(H // 2, H):
        t = (y - H // 2) / (H // 2)
        pygame.draw.line(
            canvas,
            (int(27 - 12 * t), int(34 - 12 * t), int(31 - 10 * t)),
            (0, y), (W, y)
        )

    for col in range(0, W, RAY_STEP):
        ray = angle - HALF_FOV + col / W * FOV
        dist, side, tx, ty = cast_ray(ray)
        corrected = max(0.08, dist * math.cos(ray - angle))
        wall_h = min(H * 2, int(H * 0.92 / corrected))
        top = horizon - wall_h // 2

        tex = tx % 1 if side == 0 else ty % 1
        pattern = 0.82 + 0.18 * math.sin(tex * math.pi * 8)
        fog = clamp(1 - corrected / 22, 0.16, 1.0)
        base = (110, 82, 69) if side == 0 else (76, 87, 87)
        factor = (0.82 if side == 0 else 0.64) * pattern * fog
        color = tuple(int(c * factor) for c in base)

        pygame.draw.rect(canvas, color, (col, top, RAY_STEP + 1, wall_h))
        if int(tex * 8) == 0 and corrected < 8:
            pygame.draw.line(canvas, (35, 39, 39),
                             (col, top), (col, top + wall_h), 1)

        for xx in range(col, min(W, col + RAY_STEP)):
            zbuffer[xx] = corrected

    for i in range(1, 9):
        yy = horizon + int((H - horizon) * (i / 9) ** 1.8)
        if horizon < yy < H:
            pygame.draw.line(canvas, (31, 35, 33), (0, yy), (W, yy))


def project(wx, wy, scale=1.0):
    dx, dy = wx - player_x, wy - player_y
    dist = math.hypot(dx, dy)
    if dist < 0.1:
        return None

    rel = wrap_angle(math.atan2(dy, dx) - angle)
    if abs(rel) > HALF_FOV + 0.25:
        return None

    corrected = dist * math.cos(rel)
    if corrected <= 0:
        return None

    sx = int((0.5 + rel / FOV) * W)
    size = int(H * 0.72 / corrected * scale)
    sy = H // 2 + int(pitch * H * 0.8) + int(jump_height * 0.7)
    return sx, sy, size, corrected


def draw_zombie(z):
    p = project(z["x"], z["y"], z["size"])
    if not p:
        return

    sx, sy, size, dist = p
    if size < 5:
        return

    ix = int(clamp(sx, 0, W - 1))
    if dist > zbuffer[ix] + 0.12:
        return

    scale = clamp(1.0 - dist / 15, 0.22, 1.0)
    skins = [(78, 126, 76), (118, 112, 81), (88, 103, 94)]
    skin = tuple(int(c * scale) for c in skins[z["tone"]])
    dark = tuple(int(c * scale) for c in (34, 39, 37))
    robe = tuple(int(c * scale) for c in (50, 63, 58))
    if z["hurt"] > 0:
        skin = tuple(int(c * scale) for c in (180, 45, 40))

    width = max(4, int(size * 0.60))
    height = max(6, int(size * 0.94))
    left = int(sx - width / 2)
    top = int(sy - height * 0.52)
    swing = math.sin(z["walk"] * 5) * size * 0.05

    leg_w = max(2, width // 4)
    leg_h = max(3, int(height * 0.27))
    pygame.draw.rect(canvas, dark,
                     (int(sx - width * 0.24), int(top + height * 0.72), leg_w, leg_h))
    pygame.draw.rect(canvas, dark,
                     (int(sx + width * 0.05), int(top + height * 0.72), leg_w, leg_h))

    pygame.draw.ellipse(canvas, robe,
                        (int(sx - width * 0.34), int(top + height * 0.32),
                         int(width * 0.68), int(height * 0.48)))

    pygame.draw.line(canvas, skin,
                     (int(sx - width * 0.25), int(top + height * 0.39)),
                     (int(sx - width * 0.48 + swing), int(top + height * 0.65)),
                     max(2, width // 6))
    pygame.draw.line(canvas, skin,
                     (int(sx + width * 0.25), int(top + height * 0.39)),
                     (int(sx + width * 0.48 - swing), int(top + height * 0.62)),
                     max(2, width // 6))

    head_w = max(4, int(width * 0.57))
    head_h = max(4, int(height * 0.23))
    hx, hy = int(sx - head_w / 2), int(top + height * 0.07)
    pygame.draw.ellipse(canvas, skin, (hx, hy, head_w, head_h))
    pygame.draw.rect(canvas, dark,
                     (int(sx - head_w * 0.34), int(hy + head_h * 0.55),
                      max(2, int(head_w * 0.68)), max(2, head_h // 4)))

    eye = (235, 45, 30)
    pygame.draw.circle(canvas, eye,
                       (int(sx - head_w * 0.18), int(hy + head_h * 0.43)),
                       max(1, int(head_w * 0.055)))
    pygame.draw.circle(canvas, eye,
                       (int(sx + head_w * 0.18), int(hy + head_h * 0.43)),
                       max(1, int(head_w * 0.055)))

    if z["hp"] < 100:
        bw = max(12, int(width * 1.1))
        pygame.draw.rect(canvas, (30, 20, 20), (sx - bw // 2, top - 5, bw, 3))
        pygame.draw.rect(canvas, (65, 225, 80),
                         (sx - bw // 2, top - 5, int(bw * max(0, z["hp"]) / 100), 3))


