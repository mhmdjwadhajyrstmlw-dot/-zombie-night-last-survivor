def text(msg, x, y, f=font_medium, color=(240, 245, 245), centered=False):
    img = f.render(str(msg), True, color)
    if centered:
        x -= img.get_width() // 2
    canvas.blit(img, (int(x), int(y)))


def draw_button(rect, label, active=False, small=False):
    x, y, w, h = rect
    surf = pygame.Surface((w, h), pygame.SRCALPHA)
    fill = (29, 62, 60, 185) if active else (13, 25, 29, 155)
    pygame.draw.ellipse(surf, fill, (0, 0, w, h))
    pygame.draw.ellipse(surf, (113, 194, 162, 240), (1, 1, w - 2, h - 2), 3)
    canvas.blit(surf, (x, y))
    f = font_small if small else font_medium
    img = f.render(label, True, (235, 245, 245))
    canvas.blit(img, (x + (w - img.get_width()) // 2,
                      y + (h - img.get_height()) // 2))


